<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>✦ <%= element.name_es %> / <%= element.name_en %> — Blendara</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Lora:ital,wght@0,400;0,600;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- LANGUAGE TOGGLE -->
    <div class="lang-toggle">
        <button class="lang-btn active" data-lang="es">ESP</button>
        <span class="lang-divider">|</span>
        <button class="lang-btn" data-lang="en">ENG</button>
    </div>

    <a href="/" class="back-link lang-es">← Volver al Grimorio</a>
    <a href="/" class="back-link lang-en" style="display:none">← Back to Grimoire</a>

    <article class="element-detail">
        <header class="element-header">
            <div class="element-badge <%= element.element %>"><%= element.element || '✦' %></div>
            <h1><%= element.name_es %> / <%= element.name_en %></h1>
            <p class="meta">
                <% if (element.scientific_name) { %><em><%= element.scientific_name %></em> — <% } %>
                <% if (element.element) { %><span class="lang-es">Elemento:</span><span class="lang-en" style="display:none">Element:</span> <strong><%= element.element %></strong><% } %>
                <% if (element.planet) { %> | <span class="lang-es">Planeta:</span><span class="lang-en" style="display:none">Planet:</span> <strong><%= element.planet %></strong><% } %>
                <% if (element.chakra) { %> | Chakra: <strong><%= element.chakra %></strong><% } %>
            </p>
        </header>

        <% if (element.body_benefits) { %>
        <section>
            <h2 class="lang-es">🌱 Beneficios para el Cuerpo</h2>
            <h2 class="lang-en" style="display:none">🌱 Body Benefits</h2>
            <p class="lang-es"><%- element.body_benefits.replace(/\n/g, '<br>') %></p>
            <p class="lang-en" style="display:none"><%- (element.body_benefits_en || element.body_benefits).replace(/\n/g, '<br>') %></p>
        </section>
        <% } %>

        <% if (element.spiritual_benefits) { %>
        <section>
            <h2 class="lang-es">✨ Beneficios Espirituales</h2>
            <h2 class="lang-en" style="display:none">✨ Spiritual Benefits</h2>
            <p class="lang-es"><%- element.spiritual_benefits.replace(/\n/g, '<br>') %></p>
            <p class="lang-en" style="display:none"><%- (element.spiritual_benefits_en || element.spiritual_benefits).replace(/\n/g, '<br>') %></p>
        </section>
        <% } %>

        <% if (element.uses) { %>
        <section>
            <h2 class="lang-es">📋 Formas de Uso</h2>
            <h2 class="lang-en" style="display:none">📋 How to Use</h2>
            <div class="uses lang-es"><%- element.uses.replace(/\n/g, '<br>') %></div>
            <div class="uses lang-en" style="display:none"><%- (element.uses_en || element.uses).replace(/\n/g, '<br>') %></div>
        </section>
        <% } %>

        <% if (element.precautions) { %>
        <section class="precaution-section">
            <h2 class="lang-es">⚠️ Precauciones</h2>
            <h2 class="lang-en" style="display:none">⚠️ Precautions</h2>
            <p class="lang-es"><%- element.precautions.replace(/\n/g, '<br>') %></p>
            <p class="lang-en" style="display:none"><%- (element.precautions_en || element.precautions).replace(/\n/g, '<br>') %></p>
        </section>
        <% } %>
    </article>

    <footer>
        <p>✦ Blendara Apothecary ✦</p>
    </footer>

    <script>
        let currentLang = localStorage.getItem('grimorio-lang') || 'es';
        setLanguage(currentLang);

        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const lang = btn.dataset.lang;
                setLanguage(lang);
                localStorage.setItem('grimorio-lang', lang);
            });
        });

        function setLanguage(lang) {
            document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
            document.querySelector(`.lang-btn[data-lang="${lang}"]`).classList.add('active');
            document.querySelectorAll('.lang-es').forEach(el => el.style.display = lang === 'es' ? '' : 'none');
            document.querySelectorAll('.lang-en').forEach(el => el.style.display = lang === 'en' ? '' : 'none');
        }
    </script>
</body>
</html>
